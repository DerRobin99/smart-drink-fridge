def render_page(template, **context):
    lang = get_language()

    context["lang"] = lang
    context["update_info"] = get_update_info()
    context["current_version"] = _current_version

    html = render_template_string(
        template,
        t=lambda key: _translations.get(lang, {}).get(key, key),
        **context
    )

    return html
