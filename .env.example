# Flask secret key (change this in production)
SECRET_KEY=change-me

# Password required to cancel scanner transactions
STORNO_PASSWORT=change-me

# Legacy Pushover fallback. Prefer configuring encrypted credentials under
# Settings -> Pushover notifications in the web interface.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional Tailscale remote access
TAILSCALE_ENABLED=false
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=smart-drink-fridge
# Automatically provide trusted HTTPS through Tailscale Serve
TAILSCALE_HTTPS=true

# Optional GitHub update checker
UPDATE_CHECKER_ENABLED=true

# Optional one-click Docker updates.
# WARNING: requires mounting /var/run/docker.sock and grants the web container
# extensive control over the Docker host. Enable only on a trusted network.
DOCKER_UPDATE_ENABLED=false

# Optional Nextion status display (tested with NX4832K035)
NEXTION_PORT=/dev/serial0
NEXTION_BAUD=9600
NEXTION_LANGUAGE=de
# How long a PIN-selected user remains active for the next barcode scan
NEXTION_USER_SECONDS=120

# Optional central-server mode for a scanner client. Leave SCANNER_SERVER_URL
# empty on the central server or for a single-host installation. Create the
# scanner and its token under Settings -> Locations and scanners.
SCANNER_SERVER_URL=
SCANNER_ID=local-scanner
SCANNER_TOKEN=
