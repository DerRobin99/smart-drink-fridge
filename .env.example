# Flask secret key (change this in production)
SECRET_KEY=change-me

# Password required to cancel scanner transactions
STORNO_PASSWORT=change-me

# Legacy Pushover fallback. Prefer configuring encrypted credentials under
# Settings -> Pushover notifications in the web interface.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional native iPhone push notifications (Apple APNs). Never commit the
# downloaded .p8 private key. Mount it read-only with docker-compose.apns.yml.
APNS_PRIVATE_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=de.derrobin99.smartdrinkfridge

# Optional Tailscale remote access
TAILSCALE_ENABLED=false
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=smart-drink-fridge
# Automatically provide trusted HTTPS through Tailscale Serve
TAILSCALE_HTTPS=true

# Optional GitHub update checker
UPDATE_CHECKER_ENABLED=true

# Optional one-click Docker updates.
# WARNING: requires mounting /var/run/docker.sock and grants the web container
# extensive control over the Docker host. Enable only on a trusted network.
DOCKER_UPDATE_ENABLED=false

# Optional Nextion status display (tested with NX4832K035)
NEXTION_PORT=/dev/serial0
NEXTION_BAUD=9600
NEXTION_LANGUAGE=de
# How long a PIN-selected user remains active for the next barcode scan
NEXTION_USER_SECONDS=120

# Optional central-server mode for a scanner client. Leave SCANNER_SERVER_URL
# empty on the central server or for a single-host installation. Create the
# scanner and its token under Settings -> Locations and scanners.
SCANNER_SERVER_URL=
SCANNER_ID=local-scanner
SCANNER_NAME=Local scanner
SMART_FRIDGE_IMAGE=ghcr.io/derrobin99/smart-drink-fridge:latest
# Persistent volume names used by docker-compose.edge.yml. Keep these stable
# so pairing credentials and Tailscale state survive container recreation.
EDGE_DATA_VOLUME=smart-drink-fridge-edge-data
TAILSCALE_STATE_VOLUME=smart-drink-fridge-edge-tailscale-state
SCANNER_AUTO_DISCOVERY=false
SCANNER_TOKEN=
# Select the physical barcode reader: camera (default) or usb.
SCANNER_MODE=camera
# Optional stable Linux input path. Leave empty to auto-detect a single USB
# barcode keyboard under /dev/input/by-id.
USB_SCANNER_DEVICE=
USB_SCANNER_MIN_LENGTH=8
# Timezone of the Smart Drink Fridge, using TZ time zones: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Berlin
